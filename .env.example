# ==============================================================================
# RRHH ELIZA ATS - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MOTOR DE IA (GROQ 100% GRATIS Y ULTRA RÁPIDO)
# Obtén tu API Key gratuita en: https://console.groq.com/keys
# ------------------------------------------------------------------------------
AI_PROVIDER="groq" # Opciones: groq | openai | gemini
GROQ_API_KEY="gsk_tu_clave_gratuita_de_groq_aqui"
GROQ_MODEL="llama-3.3-70b-versatile"    # Extracción estructurada JSON y re-ranking
GROQ_MODEL_FAST="llama-3.1-8b-instant"   # Clasificador ultrarrápido (0.2s) para descartar correos

# Proveedores alternativos (opcional)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (SUPABASE / POSTGRESQL + PGVECTOR)
# Copia la cadena Connection string URI desde el panel de Supabase:
# Settings > Database > Connection string (URI)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public"
# URL directa para migraciones con Prisma (puerto 5432):
DIRECT_URL="postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (GMAIL API)
# Credenciales en Google Cloud Console > APIs & Services > Credentials
# Nota: La URI de redirección se adapta dinámicamente según el dominio activo.
# Añade en Google Cloud Console:
# - http://localhost:3000/api/auth/gmail/callback
# - https://tu-subdominio.pages.dev/api/auth/gmail/callback
# - https://tu-dominio-final.com/api/auth/gmail/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"
# Si deseas pre-vincular una cuenta headless o token permanente:
GOOGLE_REFRESH_TOKEN=""
GOOGLE_USER_EMAIL=""

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD PUB/SUB (Tiempo Real)
# ------------------------------------------------------------------------------
GOOGLE_PUBSUB_TOPIC_NAME="projects/tu-proyecto/topics/gmail-push"
WEBHOOK_SECRET="tu-token-secreto-de-verificacion"

# ------------------------------------------------------------------------------
# 5. STORAGE DE ARCHIVOS (SUPABASE / CLOUDFLARE R2 / S3 / LOCAL)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local" # Opciones: local | supabase | r2 | s3
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="resumes"
S3_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 6. SINCRONIZACIÓN HISTÓRICA (BACKFILL 2024+)
# ------------------------------------------------------------------------------
BACKFILL_QUERY="has:attachment (cv OR resume OR currículum OR curriculum OR postulación OR postulacion OR empleo OR candidate) after:2024/01/01"
BACKFILL_BATCH_SIZE=20
BACKFILL_DELAY_MS=500

# ------------------------------------------------------------------------------
# 7. DOMINIO DINÁMICO
# El sistema lee automáticamente la cabecera Host / X-Forwarded-Host del servidor,
# por lo que no es obligatorio modificarlo al cambiar de dominio o subdominio.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
